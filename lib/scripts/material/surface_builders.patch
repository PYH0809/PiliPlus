diff --git a/lib/src/surface_builders.dart b/lib/src/surface_builders.dart
new file mode 100644
index 0000000..6f770cc
--- /dev/null
+++ b/lib/src/surface_builders.dart
@@ -0,0 +1,38 @@
+// PiliPlus: lets the app draw the surfaces of dialogs and popup menus itself,
+// as liquid glass does, in place of their Material.
+
+import 'package:flutter/widgets.dart';
+
+/// Builds a surface of [shape] holding [child], in place of the Material a
+/// component would draw. The surface must give [child] a Material of its own,
+/// such as one of `MaterialType.transparency`, for ink and text styles.
+typedef SurfaceBuilder = Widget Function(BuildContext context, ShapeBorder shape, Widget child);
+
+/// Builds a popup menu, surface and motion, around its laid out [child] in
+/// place of the Material that reveals it. [animation] is the route's, and
+/// [anchor] the rect the menu opens from, such as its button's, in the
+/// coordinates of the box the menu is laid out in.
+typedef MenuSurfaceBuilder =
+    Widget Function(
+      BuildContext context,
+      ShapeBorder shape,
+      Widget child,
+      Animation<double> animation,
+      Rect? anchor,
+    );
+
+/// What the app draws itself. Each one left null keeps the component's own.
+abstract final class SurfaceBuilders {
+  static SurfaceBuilder? dialog;
+  static MenuSurfaceBuilder? popupMenu;
+
+  /// Lays out an AlertDialog's actions in place of its OverflowBar.
+  static Widget Function(BuildContext context, List<Widget> actions)? dialogActions;
+
+  /// The shape of a PopupMenuItem's ink.
+  static ShapeBorder? popupMenuItemShape;
+
+  /// Marks the item a popup menu opens on, its current value, at the item's
+  /// end in place of a highlight.
+  static Widget? popupMenuCheck;
+}
